# Скопируй в .env и поправь под себя. Префикс APP_ обязателен.
# Опечатка в имени переменной уронит приложение на старте (extra="forbid").

APP_DEBUG=true
APP_LOG_LEVEL=DEBUG

APP_HTTP_TIMEOUT_SECONDS=10

APP_LLM_BASE_URL=http://localhost:11434
APP_LLM_MODEL=qwen3-coder-next-agent:latest
APP_LLM_TIMEOUT_SECONDS=300

APP_DEFAULT_CHUNK_SIZE=500
APP_DEFAULT_OVERLAP=50
